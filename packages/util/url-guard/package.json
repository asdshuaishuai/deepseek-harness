{
  "name": "@deepseek-ai/dsh-url-guard",
  "description": "Public-endpoint URL validation for server-side requests: HTTP(S)/WS(S) schemes, credential-free, and host checks that reject localhost, loopback, private, and reserved addresses",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/util/url-guard"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "ipaddr.js": "^2.2.0"
  }
}
